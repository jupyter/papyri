{
  "name": "papyri-viewer",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Read-only web viewer for papyri IR bundles. See PLAN.md.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:static": "PAPYRI_STATIC=1 astro build",
    "check:static-links": "node scripts/check-static-links.mjs",
    "preview": "astro preview",
    "serve": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run tests/",
    "test:watch": "vitest tests/",
    "seed-store": "vitest run scripts/seed-store.test.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "astro": "^7.3.1",
    "better-sqlite3": "^12.9.0",
    "cbor-x": "^1.6.4",
    "katex": "^0.16.45",
    "papyri-ingest": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro-eslint-parser": "^1.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^1.2.3",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.17.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

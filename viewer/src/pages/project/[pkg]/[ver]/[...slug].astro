---
import {
  loadModule,
  slugToQualname,
  resolveVersion,
  type IngestedDoc,
} from "../../../../lib/ir-reader.ts";
import { getBackrefs } from "../../../../lib/graph.ts";
import { getBackends } from "../../../../lib/backends.ts";
import { qualnameParams } from "../../../../lib/static-paths.ts";
import { buildQualnamePageView } from "../../../../lib/qualname-page.ts";
import { buildXrefResolver } from "../../../../lib/xref.ts";
import { linkForBundle, linkForQualname } from "../../../../lib/links.ts";
import { loadBundleNav } from "../../../../lib/nav.ts";
import { qualnameAncestors, qualnameLabel } from "../../../../lib/qualname.ts";
import IrNode from "../../../../components/IrNode.astro";
import Signature from "../../../../components/Signature.astro";
import InlineMemberDoc from "../../../../components/InlineMemberDoc.astro";
import QualnameDocSections from "../../../../components/QualnameDocSections.astro";
import BundleLayout from "../../../../layouts/BundleLayout.astro";
import { isStaticBuild } from "../../../../lib/static.ts";

// Every URL this route serves, for the static build. Ignored in server mode,
// where routes are rendered on demand.
export async function getStaticPaths() {
  return (await qualnameParams(await getBackends())).map((params) => ({ params }));
}

const { pkg, ver, slug } = Astro.params;

if (!pkg || !ver || slug === undefined) {
  return new Response("Not found", { status: 404 });
}

const qualname = slugToQualname(slug);
const { blobStore, graphDb } = await getBackends();

const actualVer = await resolveVersion(graphDb, pkg, ver);
if (!actualVer) return new Response(`Package ${pkg} not found`, { status: 404 });

let doc: IngestedDoc;
try {
  doc = await loadModule(blobStore, pkg, actualVer, qualname);
} catch {
  return new Response(`Module ${qualname} not found`, { status: 404 });
}

// Three independent async operations: graph backrefs, xref resolution, sidebar nav.
const [backrefs, resolveXref, nav] = await Promise.all([
  getBackrefs(graphDb, { pkg, ver: actualVer, kind: "module", path: qualname }),
  buildXrefResolver(graphDb, doc, pkg, actualVer),
  loadBundleNav(blobStore, pkg, actualVer, ver),
]);
const view = buildQualnamePageView(doc, backrefs, pkg);
const hasBackrefs = view.internalBackrefs.length > 0 || view.externalBackrefs.length > 0;

const githubSlug =
  typeof nav.meta.github_slug === "string" && nav.meta.github_slug ? nav.meta.github_slug : null;
// Prefer the explicit git tag over the version string (e.g. "v1.2.3" vs "1.2.3").
const sourceRef = typeof nav.meta.tag === "string" && nav.meta.tag ? nav.meta.tag : actualVer;
const sourceUrl =
  githubSlug && doc.item_file
    ? `https://github.com/${githubSlug}/blob/${sourceRef}/${doc.item_file}${doc.item_line != null ? `#L${doc.item_line}` : ""}`
    : null;

// Direct children for the on-page Members TOC. Qualnames use `:` to separate
// the module path from in-module objects, and `.` after `:` for class
// members. Examples:
//   `pkg.sub`               — submodule of `pkg`
//   `pkg.sub:func`          — function/class/attr inside module `pkg.sub`
//   `pkg.sub:Cls.method`    — method on class `pkg.sub:Cls`
const isClassPage = qualname.includes(":");
interface MemberGroup {
  title: string;
  items: { qualname: string; label: string; href: string }[];
}
const submodules: MemberGroup["items"] = [];
const moduleMembers: MemberGroup["items"] = [];
const classMembers: MemberGroup["items"] = [];

if (isClassPage) {
  const prefix = `${qualname}.`;
  for (const qa of nav.qualnames) {
    if (!qa.startsWith(prefix)) continue;
    const rest = qa.slice(prefix.length);
    if (rest.length === 0 || rest.includes(".") || rest.includes(":")) continue;
    classMembers.push({ qualname: qa, label: rest, href: linkForQualname(pkg, ver, qa) });
  }
} else {
  const dotPrefix = `${qualname}.`;
  const colonPrefix = `${qualname}:`;
  for (const qa of nav.qualnames) {
    if (qa.startsWith(dotPrefix)) {
      const rest = qa.slice(dotPrefix.length);
      if (rest.length === 0 || rest.includes(".") || rest.includes(":")) continue;
      submodules.push({ qualname: qa, label: rest, href: linkForQualname(pkg, ver, qa) });
    } else if (qa.startsWith(colonPrefix)) {
      const rest = qa.slice(colonPrefix.length);
      if (rest.length === 0 || rest.includes(".") || rest.includes(":")) continue;
      moduleMembers.push({ qualname: qa, label: rest, href: linkForQualname(pkg, ver, qa) });
    }
  }
}
const byLabel = (a: { label: string }, b: { label: string }) => a.label.localeCompare(b.label);
submodules.sort(byLabel);
moduleMembers.sort(byLabel);
classMembers.sort(byLabel);
const memberGroups: MemberGroup[] = isClassPage
  ? [{ title: "Members", items: classMembers }]
  : [
      { title: "Submodules", items: submodules },
      { title: "Members", items: moduleMembers },
    ];
const hasMembers = memberGroups.some((g) => g.items.length > 0);

// Inlinable = non-private members from all groups except Submodules.
// The server:defer islands on InlineMemberDoc fetch these individually in the
// background after the parent page has responded. A static snapshot has no
// server to fetch from, so there they are rendered eagerly instead — same
// component, same output, just paid for at build time.
const inlineItems = memberGroups
  .filter((g) => g.title !== "Submodules")
  .flatMap((g) => g.items)
  .filter((m) => !m.label.startsWith("_"));

const crumbs = qualnameAncestors(qualname).map((qa) => ({
  qualname: qa,
  label: qualnameLabel(qa),
  href: linkForQualname(pkg, ver, qa),
}));
---

<BundleLayout
  pkg={pkg}
  ver={ver}
  actualVer={actualVer}
  title={`${qualname} — Papyri viewer`}
  activeQualname={qualname}
  rawKind="module"
  rawPath={qualname}
>
  <p class="crumb">
    <a href="/">bundles</a> / <a href={linkForBundle(pkg, ver)}>{pkg} {ver}</a>
    {
      crumbs.map((c, i) =>
        i === crumbs.length - 1 ? (
          <Fragment>
            {" / "}
            <span aria-current="page">
              <code>{c.label}</code>
            </span>
          </Fragment>
        ) : (
          <Fragment>
            {" / "}
            <a href={c.href} title={c.qualname}>
              <code>{c.label}</code>
            </a>
          </Fragment>
        )
      )
    }
  </p>

  <header class="qa-header">
    {doc.item_type ? <p class="kind">{doc.item_type}</p> : null}
    <h1><code>{doc.qa}</code></h1>
    {
      doc.item_file ? (
        <p class="source">
          source:{" "}
          {sourceUrl ? (
            <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
              <code>{doc.item_file}</code>
              {doc.item_line != null ? <Fragment>:{doc.item_line}</Fragment> : null}
            </a>
          ) : (
            <Fragment>
              <code>{doc.item_file}</code>
              {doc.item_line != null ? <Fragment>:{doc.item_line}</Fragment> : null}
            </Fragment>
          )}
        </p>
      ) : null
    }
  </header>

  {
    doc.signature ? (
      <section class="signature">
        <h2>Signature</h2>
        <Signature signature={doc.signature} itemType={doc.item_type} />
      </section>
    ) : null
  }

  {
    hasMembers ? (
      <section class="doc-section doc-section-members">
        {memberGroups.map((group) =>
          group.items.length > 0 ? (
            <Fragment>
              <h2>{group.title}</h2>
              <ul class="qualnames members-toc">
                {group.items.map((m) => (
                  <li class={m.label.startsWith("_") ? "member-private" : undefined}>
                    <a href={m.href} title={m.qualname}>
                      <code>{m.label}</code>
                    </a>
                  </li>
                ))}
              </ul>
            </Fragment>
          ) : null
        )}
        {inlineItems.length > 0 ? (
          <div class="inline-members-list">
            {inlineItems.map((item) =>
              isStaticBuild() ? (
                <InlineMemberDoc
                  pkg={pkg}
                  ver={actualVer}
                  qualname={item.qualname}
                  label={item.label}
                  href={item.href}
                  githubSlug={githubSlug}
                  sourceRef={sourceRef}
                />
              ) : (
                <InlineMemberDoc
                  server:defer
                  pkg={pkg}
                  ver={actualVer}
                  qualname={item.qualname}
                  label={item.label}
                  href={item.href}
                  githubSlug={githubSlug}
                  sourceRef={sourceRef}
                />
              )
            )}
          </div>
        ) : null}
      </section>
    ) : null
  }

  <QualnameDocSections view={view} resolveXref={resolveXref} />

  {
    view.seeAlso.length > 0 ? (
      <section class="doc-section doc-section-see-also">
        <h2>See also</h2>
        <dl class="see-also">
          {view.seeAlso.map((item) => (
            <IrNode node={item} resolveXref={resolveXref} />
          ))}
        </dl>
      </section>
    ) : null
  }

  {
    doc.aliases && doc.aliases.length > 0 ? (
      <section class="aliases">
        <h2>Aliases</h2>
        <ul>
          {doc.aliases.map((a) => (
            <li>
              <code>{a}</code>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  {
    hasBackrefs ? (
      <section class="backrefs">
        <h2>Referenced by</h2>
        {view.internalBackrefs.length > 0 ? (
          <div class="backref-group">
            <h3>This package</h3>
            <ul class="qualnames">
              {view.internalBackrefs.map((b) => (
                <li>
                  <a href={b.url}>{b.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ) : null}
        {view.externalBackrefs.length > 0 ? (
          <div class="backref-group">
            <h3>Other packages</h3>
            <ul class="qualnames qualnames-external">
              {view.externalBackrefs.map((b) => (
                <li>
                  <span class="backref-pkg">{b.pkg}</span>
                  <a href={b.url}>{b.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ) : null}
      </section>
    ) : null
  }
</BundleLayout>
